<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <gltf_pbr name="SR_glass" type="surfaceshader">
    <input name="metallic" type="float" value="0" />
    <input name="roughness" type="float" value="0.01" />
    <input name="transmission" type="float" value="1" />
    <input name="ior" type="float" value="1.52" />
  </gltf_pbr>
  <surfacematerial name="PBR_Glass" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_glass" />
  </surfacematerial>
  <surfacematerial name="default" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="shader_default" />
  </surfacematerial>
  <standard_surface name="shader_default" type="surfaceshader">
    <input name="base_color" type="color3" value="0.2, 0.2, 0.2" />
    <input name="specular_roughness" type="float" value="1" />
  </standard_surface>
  <look name="look">
    <materialassign name="default" material="default" geom="base,core,sss_bars,Calibration_Mesh" />
    <materialassign name="preview" material="PBR_Glass" geom="material_surface,Preview_Mesh" />
  </look>
</materialx>
