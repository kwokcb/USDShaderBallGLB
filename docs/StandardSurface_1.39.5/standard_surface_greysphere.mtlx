<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <standard_surface name="SR_greysphere" type="surfaceshader">
    <input name="base_color" type="color3" value="0.18, 0.18, 0.18" />
    <input name="specular_roughness" type="float" value="0.7" />
  </standard_surface>
  <surfacematerial name="Greysphere" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_greysphere" />
  </surfacematerial>
  <surfacematerial name="default" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="shader_default" />
  </surfacematerial>
  <standard_surface name="shader_default" type="surfaceshader">
    <input name="base_color" type="color3" value="0.2, 0.2, 0.2" />
    <input name="specular_roughness" type="float" value="1" />
  </standard_surface>
  <look name="look">
    <materialassign name="default" material="default" geom="base,core,sss_bars,Calibration_Mesh" />
    <materialassign name="preview" material="Greysphere" geom="material_surface,Preview_Mesh" />
  </look>
</materialx>
